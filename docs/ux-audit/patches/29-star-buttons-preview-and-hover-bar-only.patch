+import Link from 'next/link';
+
+export type StarVariant = 'sleep' | 'mind' | 'insu' | 'wear' | 'mail';
+
+/**
+ * The "view project" button for the star projects: a labelled petrol body with
+ * a small themed object beside it, in the spirit of the truck on the carbon
+ * capture page but in the site palette. The label is the only thing a screen
+ * reader gets; the art is decoration (aria-hidden). Motion lives in CSS
+ * (`.star-cta` in globals.css), plays on hover, focus and press only, and is
+ * off under reduced motion.
+ */
+export default function StarButton({
+  href,
+  variant,
+  children,
+  external = false,
+}: {
+  href: string;
+  variant: StarVariant;
+  children: React.ReactNode;
+  external?: boolean;
+}) {
+  const inner = (
+    <>
+      <span className="star-cta__body">
+        {children} <span className="star-cta__arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
+      </span>
+      <span className="star-cta__art" aria-hidden="true">
+        <Art variant={variant} />
+      </span>
+    </>
+  );
+  if (external || href.startsWith('#')) {
+    return (
+      <a
+        href={href}
+        className="star-cta"
+        data-variant={variant}
+        {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
+      >
+        {inner}
+      </a>
+    );
+  }
+  return (
+    <Link href={href} className="star-cta" data-variant={variant}>
+      {inner}
+    </Link>
+  );
+}
+
+function Art({ variant }: { variant: StarVariant }) {
+  switch (variant) {
+    case 'sleep':
+      return (
+        <svg viewBox="0 0 76 56">
+          <rect className="sc-line" x="14" y="8" width="22" height="40" rx="3" />
+          <rect className="sc-petrol sc-screen" x="17" y="12" width="16" height="30" rx="1.5" />
+          <g className="sc-moon">
+            <path className="sc-bone" d="M58 14a11 11 0 1 0 6 20 9 9 0 0 1-6-20z" />
+          </g>
+          <circle className="sc-bone sc-star" cx="50" cy="12" r="1.3" />
+          <circle className="sc-bone sc-star" cx="66" cy="22" r="1.1" />
+          <circle className="sc-bone sc-star" cx="64" cy="40" r="1.2" />
+        </svg>
+      );
+    case 'mind':
+      return (
+        <svg viewBox="0 0 76 56">
+          <rect className="sc-line" x="26" y="6" width="24" height="44" rx="4" />
+          <circle className="sc-petrol sc-circle" cx="38" cy="28" r="9" />
+          <line className="sc-line" x1="34" y1="44" x2="42" y2="44" />
+        </svg>
+      );
+    case 'insu':
+      return (
+        <svg viewBox="0 0 76 56">
+          <polyline className="sc-line sc-trace" points="6,34 18,34 24,34 28,18 34,44 40,26 46,34 58,34 66,34" />
+          <path className="sc-petrol sc-drop" d="M66 36c3 4 4 6 4 8a4 4 0 0 1-8 0c0-2 1-4 4-8z" />
+        </svg>
+      );
+    case 'wear':
+      return (
+        <svg viewBox="0 0 76 56">
+          <line className="sc-line" x1="8" y1="8" x2="68" y2="8" />
+          <g className="sc-hanger">
+            <path className="sc-line" d="M38 8v4a4 4 0 1 0-4 4" />
+            <path className="sc-line" d="M38 18 14 38h48z" />
+          </g>
+        </svg>
+      );
+    case 'mail':
+      return (
+        <svg viewBox="0 0 76 56">
+          <rect className="sc-bone sc-letter" x="24" y="14" width="28" height="24" rx="1.5" />
+          <rect className="sc-line sc-envelope" x="16" y="22" width="44" height="26" rx="2" />
+          <polyline className="sc-line sc-flap-closed" points="16,22 38,38 60,22" />
+          <polyline className="sc-line sc-flap-open" points="16,22 38,10 60,22" />
+        </svg>
+      );
+  }
+}
