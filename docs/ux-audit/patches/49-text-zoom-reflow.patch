+/* Large text sizes. SiteWrapper adds `big-text` to <html> when the root font size is 150% or more.
+   Rows made of a title, a dotted leader and a right-hand label would run off the screen then, so they
+   wrap. Gated on the class so nothing changes at normal sizes. */
+html.big-text .row-wrap { flex-wrap: wrap; column-gap: 1rem; row-gap: 0.25rem; }
+html.big-text .row-wrap > dd { min-width: 0; overflow-wrap: anywhere; }
+html.big-text h1, html.big-text h2, html.big-text h3 { overflow-wrap: anywhere; }
+html.big-text main { overflow-wrap: break-word; }
