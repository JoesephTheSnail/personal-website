+
+/* ── Touch devices ──
+   Grow the hit area of small controls to at least 44x44px without changing
+   layout or looks: an invisible centred ::after, only where the primary
+   pointer is coarse. Desktop mouse behaviour is untouched. */
+@media (pointer: coarse) {
+  .tap-44,
+  .a11y-corner-btn { position: relative; }
+  .tap-44::after,
+  .a11y-corner-btn::after {
+    content: '';
+    position: absolute;
+    left: 50%;
+    top: 50%;
+    width: max(100%, 44px);
+    height: max(100%, 44px);
+    transform: translate(-50%, -50%);
+  }
+  /* iOS Safari zooms the page when a focused field is under 16px. */
+  .sidebar-input { font-size: 16px; }
+  .a11y-menu__item { min-height: 44px; }
+}
