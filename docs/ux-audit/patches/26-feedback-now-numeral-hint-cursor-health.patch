+   the text takes the petrol accent, the underline thickens and the arrow moves
+   3px. Filters use .proud-link only to mark the active one, so they are left out.
+   Hover is for a real mouse; keyboard focus gets the same cue. */
+.proud-link > span[aria-hidden='true'] { display: inline-block; transition: transform 0.25s var(--ease-out); }
+.proud-link:not(.ledger-filter):focus-visible { color: var(--accent) !important; background-size: 100% 3px; }
+.proud-link:not(.ledger-filter):focus-visible > span[aria-hidden='true'] { transform: translateX(3px); }
+@media (hover: hover) and (pointer: fine) {
+  .proud-link:not(.ledger-filter):hover { color: var(--accent) !important; background-size: 100% 3px; }
+  .proud-link:not(.ledger-filter):hover > span[aria-hidden='true'] { transform: translateX(3px); }
+}
+html.reduce-motion .proud-link > span[aria-hidden='true'] { transition: none; transform: none !important; }
+@media (prefers-reduced-motion: reduce) {
+  .proud-link > span[aria-hidden='true'] { transition: none; transform: none !important; }
