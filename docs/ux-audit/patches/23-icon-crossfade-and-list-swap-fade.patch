+
+/* ── Content swaps (filter and sort) ──
+   A short fade and 6px settle so 23 rows becoming 7 reads as "the list
+   changed" rather than a teleport. */
+@keyframes swap-in {
+  from { opacity: 0; transform: translateY(6px); }
+  to   { opacity: 1; transform: none; }
+}
+.list-swap { animation: swap-in 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
+@media (prefers-reduced-motion: reduce) {
+  .list-swap { animation-name: fade-in !important; }
+  .menu-toggle { transform: none !important; }
+}
+html.reduce-motion .list-swap { animation-name: fade-in !important; }
+html.reduce-motion .menu-toggle { transform: none !important; }
