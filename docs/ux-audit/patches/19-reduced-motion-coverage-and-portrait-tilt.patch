+/* ── Reduced motion, the pieces that used inline styles ──
+   The menu sheet, contact dialog, ledger preview and trio images set their
+   movement inline or through utilities, which the blocks above never reached.
+   Fewer and gentler, not zero: opacity fades stay, position and scale go.
+   Written twice on purpose, like the blocks above: once for the OS setting,
+   once for the in-app "Reduce motion" switch. */
+@keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }
+@keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }
+@media (prefers-reduced-motion: reduce) {
+  /* Mobile menu: keep the fade, drop the slide and the item stagger. */
+  #mobile-menu-panel[data-state='open']    { animation-name: fade-in !important; }
+  #mobile-menu-panel[data-state='closing'] { animation-name: fade-out !important; }
+  #mobile-menu-panel a,
+  #mobile-menu-panel button,
+  #mobile-menu-panel [role='group'] { animation-name: fade-in !important; animation-delay: 0ms !important; }
+  /* Contact dialog: fades in place instead of rising 14px. */
+  .contact-modal-overlay [role='dialog'] { transform: none !important; }
+  /* Ledger preview: fade only, no scale (keeps its centring translate). */
+  .ledger-preview { transform: translate(-50%, -50%) !important; }
+  /* Trio images: no hover zoom. */
+  .proud-card img { transform: none !important; }
+}
