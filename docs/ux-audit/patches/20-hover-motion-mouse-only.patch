+.rail-link:focus-visible { color: var(--accent) !important; transform: translateX(3px); }
+/* Hover motion is for a real mouse only: a tap fires :hover on touch and would
+   leave the link nudged until the next tap elsewhere. Focus stays ungated. */
+@media (hover: hover) and (pointer: fine) {
+  .rail-link:hover { color: var(--accent) !important; transform: translateX(3px); }
+}
 html.reduce-motion .rail-link { transition: none; transform: none !important; }
 
